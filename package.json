{
  "name": "playwright-learning",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "report": "playwright show-report",
    "test:watch": "playwright test --headed --workers=1",
    "test:debug": "playwright test --debug",
    "allure:clean": "rm -rf allure-results allure-report",
    "allure:generate": "allure generate ./allure-results",
    "allure:open": "allure open ./allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "typescript": "^7.0.2"
  }
}
